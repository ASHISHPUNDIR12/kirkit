# Physical Android phone: Windows laptop LAN address, after WSL forwarding/firewall setup.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# Or use your running backend's HTTPS tunnel URL (NOT the Expo tunnel URL).
# EXPO_PUBLIC_API_URL=https://YOUR-BACKEND.trycloudflare.com
# Android emulator: http://10.0.2.2:3000
# Web on this computer: http://localhost:3000
# Restart from mobile/: npx expo start --tunnel --clear
# These variables are public in the bundle. Never add DB credentials or tokens.
