NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"
# Optional direct connection for migrations. Omit when DATABASE_URL is direct.
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"
# Exact browser origins, comma separated, with no trailing slash.
# Empty in production disables cross-origin browser access; native apps still work.
CORS_ORIGINS=
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=15000
# Integration tests require a separate disposable database, never production.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kirkit_test"
# Only set to your reverse proxy's exact IP/CIDR(s); never use a blanket true.
# TRUST_PROXY=127.0.0.1/32,::1/128
